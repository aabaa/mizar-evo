reserve x, y, p, a, sentinel for set;
definition let n, m, u, element be set;
  mode RadixLabel: R is set;
  func AtomLabel: Atom -> set equals sentinel; func OtherLabel: Other -> set equals sentinel;
  func ImageLabel: image(element) -> set equals element;
  func JoinLabel: n ++ m -> set equals n;
  func PrefixLabel: ~ n -> set equals n; func PostfixLabel: n ! -> set equals n;
  attr EmptyLabel: element is empty means thesis;
  attr LinkedLabel: element is (n,m)-linked means thesis;
  attr NamedLabel: element is (n,m,u)-named means thesis;
  struct Box[n] where field value -> set; end;
end;
infix_operator("++", left, 80); prefix_operator("~", 85); postfix_operator("!", 95);
reserve complex_first for linked(~ Atom,x) R;
reserve infix_first for linked(Atom ++ Other,x) R;
reserve postfix_middle for named(x,Atom !,y) R;
reserve selector_second for linked(~ Atom,p.value) R;
reserve multi_binder_third for named(~ Atom,y,(x,y) |-> Atom) R;
reserve complex_middle for named(x,~ Atom,y) R;
reserve complex_last for linked(x,~ Atom) R;
reserve binder_first for linked(x |-> Atom,y) R;
reserve nested_collection for named(~ Atom,{x,y},[x,y]) non empty R;
reserve constructor_second for linked(~ Atom,Box[x](value: y)) R;
set ordinary_qua = a qua linked(~ Atom,image(x)) non empty R;
set after_attribute_continuation = sentinel;
