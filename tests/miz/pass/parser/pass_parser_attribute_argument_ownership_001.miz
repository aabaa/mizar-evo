reserve x, y, p, sentinel for set;
infix_operator("++", left, 80); prefix_operator("~", 85); postfix_operator("!", 95);
definition let n, m, element be set;
  mode RadixLabel: R is set;
  func AtomLabel: Atom -> set equals sentinel; func OtherLabel: Other -> set equals sentinel;
  func ImageLabel: image(element) -> set equals element;
  func JoinLabel: n ++ m -> set equals n;
  func PrefixLabel: ~ n -> set equals n; func PostfixLabel: n ! -> set equals n;
  attr EmptyLabel: element is empty means thesis; attr TaggedLabel: element is n-tagged means thesis;
end;
reserve prefix_value for tagged(~ Atom) R;
reserve infix_value for tagged(Atom ++ Other) R;
reserve postfix_value for tagged(Atom !) R;
reserve selector_value for tagged(Atom.value) R;
reserve binder_value for tagged(x |-> Atom) R;
reserve multi_value for tagged((x,y) |-> Other) R;
reserve suffix_value for tagged(~ Atom) non empty R;
reserve nested_value for tagged(image(x)) R;
reserve stale_value for tagged(~ Atom ++ Other) R;
set qua_prefix = x qua tagged(~ Atom) R;
set qua_infix = x qua tagged(Atom ++ Other) R;
set qua_postfix = x qua tagged(Atom !) R;
set qua_selector = x qua tagged(p.value) R;
set qua_binder = x qua tagged(x |-> Atom) R;
set qua_multi = x qua tagged((x,y) |-> Other) R;
set qua_suffix = x qua tagged(~ Atom) non empty R;
set qua_nested = x qua tagged(image(x)) R;
set after_attribute_ownership = sentinel;
