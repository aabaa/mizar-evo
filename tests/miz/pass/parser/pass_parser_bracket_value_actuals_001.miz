reserve x, y, p, sentinel, a for set;
infix_operator("++", left, 80); prefix_operator("~", 85); postfix_operator("!", 95);
definition let n, m, u, v, element be set;
  mode FamilyLabel: Family[n, m, u, v] is set;
  mode RadixLabel: R is set;
  struct ValueBox[n] where field value -> set; end;
  struct Inner[n] where field value -> set; end;
  func AtomLabel: Atom -> set equals sentinel; func OtherLabel: Other -> set equals sentinel;
  func ImageLabel: image(element) -> set equals element; func PickLabel: pick[n, m, u, v](element) -> set equals element;
  func JoinLabel: n ++ m -> set equals n;
  func PrefixLabel: ~ n -> set equals n;
  func PostfixLabel: n ! -> set equals n;
  pred MatchLabel: element matches[n, m, u, v] means thesis;
  attr EmptyLabel: element is empty means thesis;
end;
reserve roots for Family[x, 7, it, image(x)]; set generic_roots = pick[x, 7, it, image(x)](a);
reserve tails for Family[p.value, p.value(x,y), x with (value := y), {x,y}]; set generic_tails = pick[p.value, p.value(x,y), x with (value := y), {x,y}](a);
reserve collections for Family[[x,y], the set, {x where x is set : thesis}, x |-> x]; set generic_collections = pick[[x,y], the set, {x where x is set : thesis}, x |-> x](a);
reserve binders for Family[(x,y) |-> x, x |-> y |-> x, (x |-> x) qua set, x qua non empty R]; set generic_binders = pick[(x,y) |-> x, x |-> y |-> x, (x |-> x) qua set, x qua non empty R](a);
reserve operators for Family[Atom ++ Other, ~ Atom, Atom !, image(x) ++ Other]; set generic_operators = pick[Atom ++ Other, ~ Atom, Atom !, image(x) ++ Other](a);
reserve symbol_tails for Family[image(x) !, Atom.value, Atom with (value := x), Atom qua non empty R]; set generic_symbol_tails = pick[image(x) !, Atom.value, Atom with (value := x), Atom qua non empty R](a);
reserve constructors for Family[Inner[image(x)](value: x), Inner of x (value: y), Inner over x (value: y), pick[x,y,x,y](x)]; set generic_constructors = pick[Inner[image(x)](value: x), Inner of x (value: y), Inner over x (value: y), pick[x,y,x,y](x)](a);
reserve qualifications for Family[x qua R qua R, x qua expr of R, (x |-> x) qua non empty R, sentinel]; set generic_qualifications = pick[x qua R qua R, x qua expr of R, (x |-> x) qua non empty R, sentinel](a);
reserve nested_arguments for Family[image(~ Atom), image(Atom ++ Other), image(x |-> Atom), image((~ Atom))]; set generic_nested_arguments = pick[image(~ Atom), image(Atom ++ Other), image(x |-> Atom), image((~ Atom))](a);
reserve structure_type for ValueBox[image(x)];
set constructed = ValueBox[Inner[image(x)](value: x)](value: sentinel);
theorem PredicateActuals: x matches[x qua non empty R, Atom ++ Other, image(x), x |-> x];
theorem ActualReference: thesis;
theorem ReferenceActuals: thesis by ActualReference[x qua non empty R, Atom ++ Other, image(x), x |-> x];
set after_bracket_values = sentinel;
