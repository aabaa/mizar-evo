reserve x, y, p, sentinel for set;
definition let n, m, element be set;
  mode RadixLabel: R is set; mode FamilyLabel: Family[n] is set;
  func AtomLabel: Atom -> set equals sentinel; func OtherLabel: Other -> set equals sentinel;
  func ImageLabel: image(element) -> set equals element; func PickLabel: pick[n](element) -> set equals element;
  func JoinLabel: n ++ m -> set equals n; func PrefixLabel: ~ n -> set equals n; func PostfixLabel: n ! -> set equals n;
  attr TaggedLabel: element is n-tagged means thesis; attr LinkedLabel: element is (n,m)-linked means thesis;
  attr EmptyLabel: element is empty means thesis; struct Box[n] where field value -> set; end;
end;
infix_operator("++", left, 80); prefix_operator("~", 85); postfix_operator("!", 95);
reserve prefix_value for Family[tagged(~ Atom) R]; set generic_prefix = pick[tagged(~ Atom) R](x);
reserve infix_value for Family[tagged(Atom ++ Other) R]; set generic_infix = pick[tagged(Atom ++ Other) R](x);
reserve postfix_value for Family[tagged(Atom !) R]; set generic_postfix = pick[tagged(Atom !) R](x);
reserve selector_value for Family[tagged(p.value) R]; set generic_selector = pick[tagged(p.value) R](x);
reserve binder_value for Family[tagged(x |-> Atom) R]; set generic_binder = pick[tagged(x |-> Atom) R](x);
reserve multi_value for Family[tagged((x,y) |-> Other) non empty R]; set generic_multi = pick[tagged((x,y) |-> Other) non empty R](x);
reserve nested_value for Family[linked(image([x,{y}]),x) R]; set generic_nested = pick[linked(image([x,{y}]),x) R](x);
reserve choice_value for Family[linked(the set,x) R]; set generic_qua = pick[linked(x qua set,y) R](x);
reserve collection_value for Family[linked({x where x is set: thesis},y) R]; set generic_constructor = pick[linked(Box[x](value: y),x) R](x);
theorem BareTagged: x is tagged(~ Atom);
theorem BareNonLinked: x is non linked(~ Atom,x) & thesis;
theorem TypedTagged: x is tagged(~ Atom) R;
reserve ordinary_value for Family[image(~ Atom)]; set generic_ordinary = pick[image(~ Atom)](x);
reserve infix_control for Family[image(~ Atom) ++ Other]; set generic_postfix_control = pick[image(~ Atom) !](x);
set after_attribute_dispatch = sentinel;
