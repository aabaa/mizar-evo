definition let e, f be expr of boolean;
  algorithm inspect(e,f) -> expr of boolean do return e; end;
  let x, y, z be object; algorithm copy_term(x) -> object do return x; end;
  func NestedDef: nested (x) -> object equals x;
  pred RelDef: x rel y means x = y; pred MultiDef: x, y multi z means x = x;
end;
theorem ContextualInputs: thesis proof
  let x, y, z be object;
  A1: x = x;
  A2: y = y;
  A3: x = x by computation(inspect(A1 & A2, x = x));
  A4: x = x by computation(inspect((A1 & A2), x = x));
  thus x = x by computation(inspect(x = y, x is object));
  hence x = x by computation(inspect(not (x = y), (x = x) & (y = y)));
  then thus x = x by computation(inspect((for a being object holds a = a), (ex b being object st b = x)));
  thus thesis by computation(inspect(thesis, x = x));
  hence (thesis) by computation(inspect((thesis), x = x));
  then thus not (thesis) by computation(inspect(not (thesis), x = x));
  thus x = x by computation(inspect(A1, nested(x)));
  thus x = x by computation(inspect(not (x rel y), x = x));
  thus x = x by computation(inspect(not (x, y multi z), x = x));
  thus x = x by computation(inspect(not (x, y do not multi z), x = x));
  thus x = x by computation(copy_term((x, y) |-> x));
  thus x = x by computation(copy_term(x qua object));
  thus x = x by computation(copy_term([x, y]));
  thus x = x by computation(pkg.tools.inspect[set](A1 & A2, x = x));
  thus x = x by computation(inspect(A1 & A2, x = x), other(x), steps: 8, timeout: 20, nest: 3, replay: true);
  thus x = x by computation(steps: 8, replay: false, inspect(x = x, y = y), other());
end;
set after_contextual_inputs = sentinel;
