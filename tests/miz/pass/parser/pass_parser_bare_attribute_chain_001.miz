reserve x, y, p, sentinel for set;
definition let n, m, element be set;
  mode RadixLabel: R is set; mode FamilyLabel: Family[n] is set;
  func AtomLabel: Atom -> set equals sentinel; func OtherLabel: Other -> set equals sentinel;
  func ImageLabel: image(element) -> set equals element;
  func JoinLabel: n ++ m -> set equals n; func PrefixLabel: ~ n -> set equals n; func PostfixLabel: n ! -> set equals n;
  attr UpperLabel: element is n-TaggedUpper means thesis; attr UpperLinkedLabel: element is (n,m)-LinkedUpper means thesis; attr TaggedLabel: element is n-tagged means thesis; attr LinkedLabel: element is (n,m)-linked means thesis;
  attr EmptyLabel: element is empty means thesis; struct Box[n] where field value -> set; end;
end;
infix_operator("++", left, 80); prefix_operator("~", 85); postfix_operator("!", 95);
theorem LowerSimple: x is tagged(x) linked(y,x);
theorem LowerComplex: x is tagged(Atom ++ Other) linked(~Other,x);
theorem UpperSimple: x is TaggedUpper(x);
theorem UpperMixed: x is TaggedUpper(~Atom) empty non LinkedUpper(Atom !,x);
theorem PrefixLast: x is TaggedUpper(~Atom) (x,y)-linked;
theorem NonLast: x is tagged(~Atom) non empty;
theorem NumeralPrefixLast: x is tagged(~Atom) 0-TaggedUpper;
theorem BinderLast: x is tagged(x |-> Atom) linked((x,y) |-> Other,x);
theorem NestedLast: x is tagged(image([x,{y}])) LinkedUpper(Box[x](value:p.value),the set);
theorem QuaCollectionLast: x is tagged(x qua set) linked({x where x is set:thesis},y);
theorem AndBoundary: x is not Box.TaggedUpper(~Atom) linked(~Other,x) & thesis;
theorem GroupOrBoundary: (x is TaggedUpper(~Atom) linked(~Other,x)) or thesis;
theorem ProofBoundary: x is TaggedUpper(~Atom) linked(~Other,x) proof thus thesis; end;
theorem TypedRightmost: x is TaggedUpper(~Atom) empty linked(~Other,x) R;
theorem TypedBracket: x is TaggedUpper(~Atom) Family[x];
theorem TypedOf: x is tagged(~Atom) Family of x; theorem TypedOver: x is TaggedUpper(~Atom) Family over x;
theorem AmbiguousUpper: x is tagged(~Atom) TaggedUpper;
theorem AmbiguousEmpty: x is TaggedUpper(~Atom) empty;
set after_bare_attribute_chain = sentinel;
