definition
  struct BoundBox where
    field carrier -> set;
  end;
end;

definition
  let T be type extends BoundBox;
  let x be T;
  func TId3Def: tid3[T] x -> set equals T.carrier;
  coherence;
end;

theorem TId3Bad1: for a being object holds tid3[object] a = a
proof
  let a be object;
  thus tid3[object] a = a by TId3Def;
end;
