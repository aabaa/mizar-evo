definition
  struct GLeftPayload where
    field value -> set;
  end;

  struct GLeft where
    field payload -> GLeftPayload;
  end;

  struct GRightPayload where
    field value -> set;
  end;

  struct GRight where
    field payload -> GRightPayload;
  end;

  struct GTop where
    field payload -> GLeftPayload;
  end;

  inherit GTop extends GLeft;
  inherit GTop extends GRight;
end;
