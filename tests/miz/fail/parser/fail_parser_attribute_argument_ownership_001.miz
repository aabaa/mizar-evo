reserve x, y, sentinel for set;
infix_operator("++", left, 80); prefix_operator("~", 85);
definition let n, m, element be set;
  mode RadixLabel: R is set;
  func AtomLabel: Atom -> set equals sentinel; func OtherLabel: Other -> set equals sentinel;
  func JoinLabel: n ++ m -> set equals n; func PrefixLabel: ~ n -> set equals n;
  attr TaggedLabel: element is n-tagged means thesis;
end;
reserve prefix_head for tagged(~ Atom R;
set after_prefix_head = sentinel;
reserve binder_head for tagged(x |-> Atom R;
set after_binder_head = sentinel;
reserve prefix_missing for tagged(~ Atom;
set after_prefix_missing = sentinel;
reserve binder_missing for tagged(x |-> Atom;
set after_binder_missing = sentinel;
reserve inner_operator_missing for tagged(x |-> Atom ++ Other;
set after_inner_operator_missing = sentinel;
reserve balanced_missing for tagged(~ Atom);
set after_balanced_missing = sentinel;
reserve legacy_missing for tagged(x R;
set after_legacy_missing = sentinel;
reserve legacy_balanced for tagged(x R) R;
set after_legacy_balanced = sentinel;
