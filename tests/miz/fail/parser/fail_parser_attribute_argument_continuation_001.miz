reserve x, y, sentinel for set;
definition let n, m, u, element be set;
  mode RadixLabel: R is set;
  func AtomLabel: Atom -> set equals sentinel; func OtherLabel: Other -> set equals sentinel;
  func PrefixLabel: ~ n -> set equals n;
  attr LinkedLabel: element is (n,m)-linked means thesis;
  attr NamedLabel: element is (n,m,u)-named means thesis;
end;
prefix_operator("~", 85);
reserve trailing_comma for linked(~ Atom,) R;
set after_trailing_comma = sentinel;
reserve leading_comma for linked(,~ Atom) R;
set after_leading_comma = sentinel;
reserve repeated_comma for named(~ Atom,,x) R;
set after_repeated_comma = sentinel;
reserve empty_arguments for linked() R;
set after_empty_arguments = sentinel;
reserve missing_close for linked(~ Atom,x R;
set after_missing_close = sentinel;
reserve complex_missing_close for linked(~ Atom,~ Other R;
set after_complex_missing_close = sentinel;
reserve balanced_missing_head for linked(~ Atom,x);
set after_balanced_missing_head = sentinel;
reserve missing_comma for linked(~ Atom x) R;
set after_missing_comma = sentinel;
